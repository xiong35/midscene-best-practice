# Copy this file to .env and replace the placeholders.
# Never commit .env or an API key.
MIDSCENE_MODEL_BASE_URL="https://replace-with-your-model-provider.example.com/v1"
MIDSCENE_MODEL_API_KEY="replace-with-your-api-key"
MIDSCENE_MODEL_NAME="replace-with-your-model-name"
MIDSCENE_MODEL_FAMILY="replace-with-the-correct-model-family"

# Project-specific Agent option. The code passes it to AndroidAgent explicitly.
# A value of 2 turns a 1440x3200 screenshot into 720x1600 before model upload.
ANDROID_SCREENSHOT_SHRINK_FACTOR="2"

# Optional: required only when more than one Android device is connected.
ANDROID_DEVICE_ID=""

# Dongchedi's common Android package name. Verify it on the actual device.
DONGCHEDI_PACKAGE="com.ss.android.auto"
